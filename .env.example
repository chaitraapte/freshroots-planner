# Neon pooled connection string (host contains -pooler), used by the app and engine
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional non-pooled string, used only for migrations
DATABASE_URL_DIRECT=
# Separate Neon branch named "test". Tests use only this; it must differ from DATABASE_URL.
TEST_DATABASE_URL=
# Optional, only for the explanation-rewording toggle
ANTHROPIC_API_KEY=
# Set to csv for offline read-only mode
STORAGE=
# Required to enable ANY write (SKU manager, decisions, re-run, config). Unset = the dashboard is read-only.
APP_PASSCODE=
# Optional AI helper ("Ask about this SKU"). Gemini is used if set, else Claude. It explains; it never decides.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional AI helper via OpenRouter (Google models only). Takes priority over GEMINI_API_KEY.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
